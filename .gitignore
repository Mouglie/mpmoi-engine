# mpmoi engine — public AGPL repo .gitignore
# The native artifacts below are the "corresponding source" OUTPUT — they are
# regenerated from the vendored source by the build scripts, never committed.

# Engine binaries (build.sh / build-win.sh output)
/engine/mpmoi-engine
/engine/mpmoi-engine.exe

# Rust build cache for libsignal (multi-GB; regenerated by src-signal/build*.sh)
**/target/

# Prebuilt native static libs (regenerated by src-signal/build*.sh)
**/libsignal_ffi.a
/infra/matrix-native/src-signal/win-x64/

# Stray dev/spike binaries
**/mpmoi-spike

# Editor / OS noise
.idea/
.vscode/
.DS_Store
node_modules/
